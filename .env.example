# Supabase project — get these from Project Settings → API Keys
# (sb_publishable_xxx or the legacy anon key both work for client-side)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# WebRTC TURN — required for ~1 in 6 cross-network connections.
# Free tiers: metered.ca, twilio (paid), cloudflare (paid).
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_CRED=

# MediaPipe WASM / model overrides — all optional.
# VITE_MEDIAPIPE_WASM=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm
# VITE_HAND_MODEL=https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task
# VITE_FACE_MODEL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
